[submodule ".registry"]
	path = .registry
	url = https://github.com/r-causal/r-causal.r-universe.dev
	branch = HEAD
[submodule "balancing"]
	path = balancing
	url = https://github.com/r-causal/balancing
[submodule "causalgenerics"]
	path = causalgenerics
	url = https://github.com/r-causal/causalgenerics
[submodule "causalpie"]
	path = causalpie
	url = https://github.com/r-causal/causalpie
[submodule "causalworkshop"]
	path = causalworkshop
	url = https://github.com/r-causal/causalworkshop
[submodule "deli"]
	path = deli
	url = https://github.com/r-causal/deli
[submodule "ggarrow"]
	path = ggarrow
	url = https://github.com/teunbrand/ggarrow
[submodule "ggdag"]
	path = ggdag
	url = https://github.com/r-causal/ggdag
[submodule "halfmoon"]
	path = halfmoon
	url = https://github.com/r-causal/halfmoon
[submodule "marginaleffects"]
	path = marginaleffects
	url = https://github.com/malcolmbarrett/marginaleffects
	branch = ipw-support
	subdir = r
[submodule "positively"]
	path = positively
	url = https://github.com/r-causal/positively
[submodule "propensity"]
	path = propensity
	url = https://github.com/r-causal/propensity
[submodule "quartets"]
	path = quartets
	url = https://github.com/r-causal/quartets
[submodule "tidysmd"]
	path = tidysmd
	url = https://github.com/r-causal/tidysmd
[submodule "tipr"]
	path = tipr
	url = https://github.com/r-causal/tipr
[submodule "touringplans"]
	path = touringplans
	url = https://github.com/LucyMcGowan/touringplans
